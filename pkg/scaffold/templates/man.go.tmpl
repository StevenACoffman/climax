// Package man implements the "man" CLI command.
package man

import (
	"context"
	"fmt"

	mff "github.com/StevenACoffman/mango-ff"
	"github.com/muesli/roff"
	"github.com/peterbourgon/ff/v4"

	"APP_IMPORT/cmd/ROOT_PKG"
)

// Config holds the configuration for the man command.
type Config struct {
	*ROOT_PKG.Config
	Section int
	Flags   *ff.FlagSet
	Command *ff.Command
}

// New creates and registers the man command with the given parent config.
func New(parent *ROOT_PKG.Config) *Config {
	var cfg Config
	cfg.Config = parent
	cfg.Flags = ff.NewFlagSet("man").SetParent(parent.Flags)
	cfg.Flags.IntVar(&cfg.Section, 0, "section", MAN_SECTION, "man page section number (1–8)")
	cfg.Command = &ff.Command{
		Name:      "man",
		Usage:     "APP_NAME man [--section N]",
		ShortHelp: "print the man page to stdout",
		LongHelp:  "Print the man page for APP_NAME in roff format to stdout.\n\nPipe to the man pager:  APP_NAME man | man -l -",
		Flags:     cfg.Flags,
		Exec:      cfg.exec,
	}
	parent.Command.Subcommands = append(parent.Command.Subcommands, cfg.Command)
	return &cfg
}

func (cfg *Config) exec(_ context.Context, _ []string) error {
	manPage, err := mff.NewManPage(uint(cfg.Section), cfg.Config.Command)
	if err != nil {
		return fmt.Errorf("man: %w", err)
	}
MAN_WITH_SECTIONS	_, _ = fmt.Fprint(cfg.Stdout, manPage.Build(roff.NewDocument()))
	return nil
}
